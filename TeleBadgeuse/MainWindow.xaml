<Window x:Class="TeleBadgeuse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TeleBadgeuse"
        mc:Ignorable="d"
        Title="TéléBadgeuse" Height="450" Width="800"
        Icon="Ressources/Icons/IconLight.ico"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">


    <Grid Background="{DynamicResource BackgroundBrush}">
        <Border  MouseDown="TitleBar_MouseDown" Background="{DynamicResource AccentBrush}" Height="30" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- Colonne pour le titre -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Colonne pour les boutons -->
                </Grid.ColumnDefinitions>

                <!-- Titre dans la première colonne -->
                <TextBlock Text="TéléBadgeuse" 
                   Foreground="{DynamicResource ForegroundBrush}" 
                   VerticalAlignment="Center" 
                   Margin="10,0"
                   Grid.Column="0" />

                <!-- Boutons dans la deuxième colonne, alignés à droite -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                    <Button Content="🗕" Click="Minimize_Click" Width="30" Background="Transparent"/>
                    <Button Content="🗖" Click="Maximize_Click" Width="30" Background="Transparent"/>
                    <Button Content="✕" Click="Close_Click" Width="30" Background="Transparent"/>
                </StackPanel>
            </Grid>
        </Border>

        <CheckBox Content="Thème Sombre" 
                  IsChecked="{Binding DarkTheme, Mode=TwoWay}" 
                  HorizontalAlignment="Center" VerticalAlignment="Top" 
                  Margin="10"
                  Foreground="{DynamicResource ForegroundBrush}"/>
        <Image HorizontalAlignment="Left" Height="100" Margin="186,147,0,0" VerticalAlignment="Top" Width="100" Source="/Ressources/Icons/IconLight.png"/>
    </Grid>
</Window>
