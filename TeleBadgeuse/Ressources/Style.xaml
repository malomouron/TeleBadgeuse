    <Style x:Key="ResizeLeftBar">
        <Setter Property="Button.Background" Value="Transparent"/>
        <Setter Property="Button.BorderBrush" Value="Transparent"/>
        <Setter Property="Button.BorderThickness" Value="0"/>
        <Setter Property="Button.Margin" Value="0 7"/>
        <Setter Property="Button.Width" Value="40"/>
        <Setter Property="Button.Height" Value="40"/>
        <Setter Property="Button.Cursor" Value="Hand" />

        <!-- Effet de survol -->
        <Setter Property="Button.Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0,20,20,0">
                        <Grid>
                            <!-- Contenu du bouton (icône) -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>
