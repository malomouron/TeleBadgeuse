<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    
    <Color x:Key="IsMouseHoverBackgroundAccentColor">#66DDDDDD</Color> 
    <Color x:Key="IsPressedBackgroundAccentColor">#66CCCCCC</Color> 
    <Color x:Key="AccentColor">#FF584D</Color>
    <Color x:Key="AccentColorTranspent">#BBFF584D</Color>
    
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="IsMouseHoverBackgroundAccentBrush" Color="{StaticResource IsMouseHoverBackgroundAccentColor}" />
    <SolidColorBrush x:Key="IsPressedBackgroundAccentBrush" Color="{StaticResource IsPressedBackgroundAccentColor}" />
    <SolidColorBrush x:Key="AccentBrushTransparent" Color="{StaticResource AccentColorTranspent}" />

    <Style x:Key="Title1" TargetType="TextBlock">
        <Setter Property="TextBlock.FontSize" Value="30"/>
        <Setter Property="TextBlock.Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style x:Key="Title2" TargetType="TextBlock">
        <Setter Property="TextBlock.FontSize" Value="25"/>
        <Setter Property="TextBlock.Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="TextBlock.Margin" Value="0"/>
    </Style>

    <Style x:Key="Info" TargetType="TextBlock">
        <Setter Property="Margin" Value="20 5"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>
    
    <Style x:Key="ListView" TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrushBis}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Width" Value="350"/>
        <Setter Property="Padding" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DisplayHour">
        <Setter Property="TextBlock.Background" Value="{DynamicResource ForegroundBrushBis}"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="TextBlock.FontSize" Value="20"/>
        <Setter Property="TextBlock.Padding" Value="5"/>
    </Style>
    <Style x:Key="ArrowDisplayHour">
        <Setter Property="TextBlock.Background" Value="{DynamicResource ForegroundBrushBis}"/>
