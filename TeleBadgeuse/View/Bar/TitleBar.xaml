<UserControl x:Class="TeleBadgeuse.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border  MouseDown="TitleBar_MouseDown" Background="{DynamicResource BackgroundBrushBis}" Height="40" VerticalAlignment="Top">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- Colonne pour le titre -->
                <ColumnDefinition Width="Auto" />
                <!-- Colonne pour les boutons -->
            </Grid.ColumnDefinitions>

            <!-- Titre dans la première colonne -->
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="15,5" Grid.Column="0">
                <Image  Height="20" Width="20" Source="{Binding ImageSource}"/>
                <TextBlock Margin="10,5" Text="{DynamicResource AppName}" 
                           Foreground="{DynamicResource ForegroundBrush}" />
            </StackPanel>
                
            <!-- Boutons dans la deuxième colonne, alignés à droite -->
            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="🗕" Foreground="{DynamicResource ForegroundBrush}" Style="{StaticResource BtnControlWindows}" Click="Minimize_Click" />
                <Button Content="🗖" Foreground="{DynamicResource ForegroundBrush}" Style="{StaticResource BtnControlWindows}" Click="Maximize_Click"/>
                <Button Content="✕" Style="{StaticResource BtnCloseWindow}" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>