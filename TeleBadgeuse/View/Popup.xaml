<UserControl x:Class="TeleBadgeuse.Popup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/Ressources/Style.xaml" />
    </UserControl.Resources>
    <Grid Background="#80000000">
        <Border Background="White" Padding="80 35" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="{Binding Message}" FontSize="25" Margin="0,0,0,20" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PopUpBtn}" Content="{DynamicResource Yes}" Command="{Binding YesCommand}" Margin="10,0"/>
                    <Button Style="{StaticResource PopUpBtn}"  Content="{DynamicResource No}" Command="{Binding NoCommand}" Margin="10,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>