<!-- SettingsPage.xaml -->
<Page x:Class="TeleBadgeuse.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ComboBox Grid.Row="1" x:Name="LanguageComboBox" SelectionChanged="LanguageComboBox_SelectionChanged"  Width="120" Height="21" >
            <ComboBoxItem Content="{DynamicResource LangFr}"/>
            <ComboBoxItem Content="{DynamicResource LangEn}"/>
        </ComboBox>
        <CheckBox Grid.Row="2" Content="{DynamicResource DarkTheme}" 
                  IsChecked="{Binding DarkTheme, Mode=TwoWay}" 
                  HorizontalAlignment="Center" VerticalAlignment="Top" 
                  Margin="10"
                  Foreground="{DynamicResource ForegroundBrush}"/>
    </Grid>
</Page>