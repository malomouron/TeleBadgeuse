<!-- HomePage.xaml -->
<Page x:Class="TeleBadgeuse.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ressources de la page -->
    <Page.Resources>
        <ResourceDictionary Source="pack://application:,,,/TeleBadgeuse;component/Ressources/Style.xaml" />
    </Page.Resources>
    <!-- Grille principale -->
    <Grid>
        <!-- Définition des colonnes de la grille -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <!-- Définition des lignes de la grille -->
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <!-- Affichage de l'heure actuelle -->
        <TextBlock x:Name="CurrentTimeTextBlock" Grid.ColumnSpan="5" VerticalAlignment="Center" Style="{StaticResource HoursText}" Foreground="{DynamicResource ForegroundBrush}" HorizontalAlignment="Center"/>
        <!-- Bouton pour démarrer -->
        <Button Grid.Column="1" Grid.Row="2" Style="{StaticResource Comming}" Content="{DynamicResource Start}" Click="Start_Click"/>
        <!-- Bouton pour terminer -->
        <Button Grid.Column="3" Grid.Row="2" Style="{StaticResource Comming}" Content="{DynamicResource End}" Click="End_Click"/>
        <!-- Contrôle de contenu pour afficher les popups -->
        <ContentControl x:Name="PopupContentControl" Grid.ColumnSpan="5" Grid.RowSpan="4" Visibility="Collapsed"/>
    </Grid>
</Page>