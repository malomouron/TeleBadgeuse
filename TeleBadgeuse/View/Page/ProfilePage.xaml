<!-- ProfilePage.xaml -->
<Page x:Class="TeleBadgeuse.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <ResourceDictionary Source="pack://application:,,,/Ressources/Style.xaml" />
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.25*"/>
            <RowDefinition Height="0.75*"/>
            <RowDefinition Height="0.75*"/>
            <RowDefinition Height="0.25*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Radio Buttons -->
        <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <RadioButton Content="All" Style="{StaticResource CustomRadioButtonStyleLeft}" GroupName="Filter" IsChecked="{Binding IsAllSelected}"/>
            <RadioButton Content="Years" Style="{StaticResource CustomRadioButtonStyle}" GroupName="Filter" IsChecked="{Binding IsYearsSelected}" />
            <RadioButton Content="Months" Style="{StaticResource CustomRadioButtonStyle}" GroupName="Filter" IsChecked="{Binding IsMonthsSelected}"/>
            <RadioButton Content="Days" Style="{StaticResource CustomRadioButtonStyleRight}" GroupName="Filter" IsChecked="{Binding IsDaysSelected}"/>
        </StackPanel>

        <!-- Navigation Buttons -->
        <StackPanel x:Name="AddTime" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Style="{StaticResource ModifDateLeft}" Content="-" Command="{Binding DecrementCommand}"/>
            <!-- Date Preview -->
            <Border Style="{StaticResource ModifDateBorder}" Width="100">
                <TextBlock Style="{StaticResource ModifDate}" Text="{Binding SelectedDatePreview}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
            </Border>
            <Button Style="{StaticResource ModifDateRight}" Content="+" Command="{Binding IncrementCommand}"/>
        </StackPanel>


        <!-- DataGrid -->
        <DataGrid Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="4" ItemsSource="{Binding Badges}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*"/>
                <DataGridTextColumn Header="Is Start" Binding="{Binding IsStart}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>