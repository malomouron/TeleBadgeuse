<!-- ProfilePage.xaml -->
<Page x:Class="TeleBadgeuse.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.25*"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="0.25*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Radio Buttons -->
        <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
            <RadioButton Content="All" GroupName="Filter" IsChecked="{Binding IsAllSelected}" Margin="10,0"/>
            <RadioButton Content="Years" GroupName="Filter" IsChecked="{Binding IsYearsSelected}" Margin="10,0"/>
            <RadioButton Content="Months" GroupName="Filter" IsChecked="{Binding IsMonthsSelected}" Margin="10,0"/>
            <RadioButton Content="Days" GroupName="Filter" IsChecked="{Binding IsDaysSelected}" Margin="10,0"/>
        </StackPanel>

        <!-- Navigation Buttons -->
        <StackPanel Grid.Column="3" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Background="White" Content="-" Command="{Binding DecrementCommand}" Margin="10,0"/>
            <!-- Date Preview -->
            <TextBlock Text="{Binding SelectedDatePreview}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
            <Button Background="White" Content="+" Command="{Binding IncrementCommand}" Margin="10,0"/>
        </StackPanel>


        <!-- DataGrid -->
        <DataGrid Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="3" ItemsSource="{Binding Badges}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*"/>
                <DataGridTextColumn Header="Is Start" Binding="{Binding IsStart}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>