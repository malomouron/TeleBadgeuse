<!-- ProfilePage.xaml -->
<Page x:Class="TeleBadgeuse.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:global="clr-namespace:"
      xmlns:webview2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Page.Resources>
        <ResourceDictionary Source="pack://application:,,,/Ressources/Style.xaml" />
    </Page.Resources>
    <Grid>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <global:BooleanToColumnConverter x:Key="BooleanToColumnConverter" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.25*"/>
            <RowDefinition Height="0.75*"/>
            <RowDefinition Height="0.75*"/>
            <RowDefinition Height="0.25*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Radio Buttons -->
        <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <RadioButton Content="{DynamicResource All}" Style="{StaticResource CustomRadioButtonStyleLeft}" GroupName="Filter" IsChecked="{Binding IsAllSelected}"/>
            <RadioButton Content="{DynamicResource Years}" Style="{StaticResource CustomRadioButtonStyle}" GroupName="Filter" IsChecked="{Binding IsYearsSelected}" />
            <RadioButton Content="{DynamicResource Months}" Style="{StaticResource CustomRadioButtonStyle}" GroupName="Filter" IsChecked="{Binding IsMonthsSelected}"/>
            <RadioButton Content="{DynamicResource Days}" Style="{StaticResource CustomRadioButtonStyleRight}" GroupName="Filter" IsChecked="{Binding IsDaysSelected}"/>
        </StackPanel>

        <!-- Navigation Buttons -->
        <StackPanel x:Name="AddTime" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Style="{StaticResource ModifDateLeft}" Content="-" Command="{Binding DecrementCommand}"/>
            <!-- Date Preview -->
            <Border Style="{StaticResource ModifDateBorder}" Width="100">
                <TextBlock Style="{StaticResource ModifDate}" Text="{Binding SelectedDatePreview}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
            </Border>
            <Button Style="{StaticResource ModifDateRight}" Content="+" Command="{Binding IncrementCommand}"/>
        </StackPanel>
        
        <!-- View Buttons -->
        <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="3" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
            <RadioButton GroupName="View" Style="{StaticResource CustomRadioButtonStyleTop}" Content="{materialDesign:PackIcon Kind=ViewList}" IsChecked="{Binding IsViewListSelected}"/>
            <RadioButton GroupName="View" Style="{StaticResource CustomRadioButtonStyleVertical}" Content="{materialDesign:PackIcon Kind=ViewGrid}" IsChecked="{Binding IsViewGridSelected}"/>
            <RadioButton GroupName="View" Style="{StaticResource CustomRadioButtonStyleVertical}" Content="{materialDesign:PackIcon Kind=ViewModule}" IsChecked="{Binding IsViewModuleSelected}"/>
            <RadioButton GroupName="View" Style="{StaticResource CustomRadioButtonStyleBottom}" Content="{materialDesign:PackIcon Kind=Timeline}" IsChecked="{Binding IsTimelineSelected}"/>
        </StackPanel>


        <!-- DataGrid -->
        <DataGrid Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="4" ItemsSource="{Binding Badges}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding IsViewListSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*"/>
                <DataGridTextColumn Header="Is Start" Binding="{Binding IsStart}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        
        
        <ListView Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="4" ItemsSource="{Binding MergedBadges}" Visibility="{Binding IsViewGridSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Colonnes pour StartBadge -->
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="*" />
                            <!-- Espacement -->
                            <ColumnDefinition Width="20" />
                            <!-- Colonnes pour EndBadge -->
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- StartBadge -->
                        <TextBlock Margin="1" Grid.Column="1" Text="{Binding StartBadge.Date, StringFormat=dd/MM/yyyy HH:mm}" />

                        <!-- Spacer -->
                        <TextBlock Grid.Column="3" Text="|" HorizontalAlignment="Center" />

                        <!-- EndBadge -->
                        <TextBlock Margin="1" Grid.Column="5" Text="{Binding EndBadge.Date, StringFormat=dd/MM/yyyy HH:mm}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>