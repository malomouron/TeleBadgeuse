<!-- PopupError.xaml -->
<UserControl x:Class="TeleBadgeuse.PopupError"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ressources de l'utilisateur -->
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/TeleBadgeuse;component/Ressources/Style.xaml" />
    </UserControl.Resources>
    <!-- Grille principale avec fond semi-transparent -->
    <Grid Background="#80000000">
        <!-- Bordure blanche avec coins arrondis -->
        <Border Background="White" Padding="80 35" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <!-- Message d'erreur du popup -->
                <TextBlock Text="{Binding Message}" FontSize="25" Margin="0,0,0,20" TextAlignment="Center"/>
                <!-- Bouton OK -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PopUpBtn}" Content="{DynamicResource Okay}" Command="{Binding OkayCommand}" Margin="10,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>