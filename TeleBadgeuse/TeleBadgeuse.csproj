<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Ressources\Icons\IconLight.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="config.json" />
    <None Remove="Ressources\Icons\IconDark.ico" />
    <None Remove="Ressources\Icons\IconDarkFull.png" />
    <None Remove="Ressources\Icons\IconLight.ico" />
    <None Remove="Ressources\Icons\IconLightFull.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Ressources\Icons\IconDark.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Ressources\Icons\IconLight.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Remove="Ressources\Icons\IconLightFull.ico" />
    <Content Include="Ressources\Icons\IconLightFull.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Remove="Ressources\Icons\IconDarkFull.ico" />
    <Content Include="Ressources\Icons\IconDarkFull.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Remove="my_html.html" />
  </ItemGroup>

	
  <ItemGroup>
    <None Remove="Ressources\Icons\IconDark.png" />
    <Resource Include="Ressources\Icons\IconDark.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <None Remove="Ressources\Icons\IconLight.png" />
    <Resource Include="Ressources\Icons\IconDarkFull.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Ressources\Icons\IconLight.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Ressources\Icons\IconLightFull.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <None Remove="Ressources\my_html.html" />
  </ItemGroup>

	
  <ItemGroup>
    <EmbeddedResource Update="Ressources\resx\resx.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>App.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Ressources\resx\resx.en.resx">
      <DependentUpon>resx.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

	
  <ItemGroup>
    <Compile Update="Ressources\resx\resx.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>resx.resx</DependentUpon>
    </Compile>
  </ItemGroup>

	
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0-preview1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.1.1-ci795" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2895-prerelease" />
    <PackageReference Include="System.Data.SQLite" Version="1.0.119" />
  </ItemGroup>

	
  <ItemGroup>
    <Page Update="View\Bar\LeftNavBar.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>Wpf</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="View\Bar\TitleBar.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>Wpf</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

	
  <ProjectExtensions><VisualStudio><UserProperties /></VisualStudio></ProjectExtensions>

</Project>
