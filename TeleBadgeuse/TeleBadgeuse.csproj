<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Ressources\Icons\IconLight.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Ressources\Icons\IconDark.ico" />
    <None Remove="Ressources\Icons\IconLight.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Ressources\Icons\IconDark.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Ressources\Icons\IconLight.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

	
  <ItemGroup>
    <Folder Include="Model\" />
    <Folder Include="View\" />
	<Folder Include="ViewModel\" />
  </ItemGroup>

	
  <ItemGroup>
    <None Remove="Ressources\Icons\IconDark.png" />
    <Resource Include="Ressources\Icons\IconDark.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <None Remove="Ressources\Icons\IconLight.png" />
    <Resource Include="Ressources\Icons\IconLight.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
